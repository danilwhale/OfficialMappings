CLASS bcf net/minecraft/client/model/Vertex
	FIELD a pos Latc;
	FIELD b u F
	FIELD c v F
	METHOD <init> (FFFFF)V
		ARG 1 x
		ARG 2 y
		ARG 3 z
		ARG 4 u
		ARG 5 v
	METHOD <init> (Latc;FF)V
		ARG 1 pos
		ARG 2 u
		ARG 3 v
	METHOD <init> (Lbcf;FF)V
		ARG 1 vertex
		ARG 2 u
		ARG 3 v
	METHOD a remap (FF)Lbcf;
		ARG 1 u
		ARG 2 v
