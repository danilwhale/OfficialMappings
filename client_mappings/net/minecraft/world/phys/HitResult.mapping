CLASS ayi net/minecraft/world/phys/HitResult
	FIELD a type Layj;
	FIELD b x I
	FIELD c y I
	FIELD d z I
	FIELD e f I
	FIELD f pos Layk;
	FIELD g entity Lqn;
	METHOD <init> (IIIILayk;)V
		ARG 1 x
		ARG 2 y
		ARG 3 z
		ARG 4 f
		ARG 5 pos
	METHOD <init> (IIIILayk;Z)V
		ARG 1 x
		ARG 2 y
		ARG 3 z
		ARG 4 f
		ARG 5 pos
		ARG 6 hit
	METHOD <init> (Lqn;)V
