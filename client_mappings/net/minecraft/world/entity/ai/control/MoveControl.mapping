CLASS pf net/minecraft/world/entity/ai/control/MoveControl
	FIELD a mob Log;
	FIELD b wantedX D
	FIELD c wantedY D
	FIELD d wantedZ D
	FIELD e speedModifier D
	FIELD f hasWanted Z
	METHOD <init> (Log;)V
		ARG 1 mob
	METHOD a hasWanted ()Z
	METHOD a setWantedPosition (DDDD)V
		ARG 1 x
		ARG 3 y
		ARG 5 z
		ARG 7 speedModifier
	METHOD a rotlerp (FFF)F
		ARG 1 x
		ARG 2 y
		ARG 3 z
	METHOD b getSpeedModifier ()D
	METHOD c tick ()V
