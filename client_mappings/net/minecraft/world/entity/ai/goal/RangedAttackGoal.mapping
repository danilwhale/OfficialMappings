CLASS qn net/minecraft/world/entity/ai/goal/RangedAttackGoal
	FIELD a mob Log;
	FIELD b rangedAttackMob Lto;
	FIELD c target Lof;
	FIELD d attackTime I
	FIELD e speedModifier D
	FIELD f seeTime I
	FIELD g attackIntervalMin I
	FIELD h attackIntervalMax I
	FIELD i attackRadius F
	FIELD j attackRadiusSqr F
	METHOD <init> (Lto;DIF)V
		ARG 1 mob
		ARG 2 speedModifier
		ARG 4 attackInterval
		ARG 5 attackRadius
	METHOD <init> (Lto;DIIF)V
		ARG 1 mob
		ARG 2 speedModifier
		ARG 4 attackIntervalMin
		ARG 5 attackIntervalMax
		ARG 6 attackRadius
