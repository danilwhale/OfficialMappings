CLASS tp net/minecraft/world/entity/monster/SharedMonsterAttributes
	FIELD a MAX_HEALTH Lor;
	FIELD b FOLLOW_RANGE Lor;
	FIELD c KNOCKBACK_RESISTANCE Lor;
	FIELD d MOVEMENT_SPEED Lor;
	FIELD e ATTACK_DAMAGE Lor;
	METHOD a loadAttributeModifier (Lby;)Lot;
		ARG 0 tag
	METHOD a saveAttribute (Los;)Lby;
		ARG 0 instance
	METHOD a loadAttribute (Los;Lby;)V
		ARG 0 attribute
		ARG 1 tag
	METHOD a saveAttributeModifier (Lot;)Lby;
		ARG 0 modifier
	METHOD a saveAttributes (Lov;)Lcg;
		ARG 0 map
	METHOD a loadAttributes (Lov;Lcg;Llp;)V
