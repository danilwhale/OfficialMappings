CLASS act net/minecraft/world/level/biome/BiomeCache$Area
	FIELD a temperatures [F
	FIELD b downfalls [F
	FIELD c biomes [Lacq;
	FIELD d x I
	FIELD e z I
	FIELD f lastMs J
	FIELD g this$0 Lacs;
