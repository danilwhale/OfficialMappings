		ARG 1 id
		ARG 2 fruit
	METHOD d getConnectDir (Lacf;III)I
		ARG 1 level
		ARG 2 x
		ARG 3 y
		ARG 4 z
	METHOD k growCrops (Labw;III)V
		ARG 1 level
		ARG 2 x
		ARG 3 y
		ARG 4 z
	METHOD m getGrowthSpeed (Labw;III)F
		ARG 1 level
		ARG 2 x
		ARG 3 y
		ARG 4 z
	METHOD q getAngledTexture ()Lms;
